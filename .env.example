# Copied to .env by `make up` with a random password. Never commit .env.
NEO4J_PASSWORD=change-me-please
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
NEO4J_HEAP=1G
NEO4J_PAGECACHE=1G
# NEO4J_IMAGE=neo4j:5.26-community

# Prebuilt graph. If set and the graph is empty, `make up` downloads and loads
# this dump instead of ingesting from sources (seconds instead of minutes).
# CGRAPH_DUMP_URL=https://github.com/Villan2322/compliance-graph/releases/download/v0.1.0/neo4j.dump

# LLM (optional). none | ollama | anthropic
CGRAPH_LLM_PROVIDER=none
CGRAPH_LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434
# For Anthropic: CGRAPH_LLM_PROVIDER=anthropic, CGRAPH_LLM_MODEL=claude-sonnet-5, ANTHROPIC_API_KEY=...

# Audit loop
CGRAPH_REVIEW_THRESHOLD=15
# Extra Semgrep registry packs (needs network): e.g. "p/python p/javascript p/owasp-top-ten"
CGRAPH_SEMGREP_CONFIGS=
